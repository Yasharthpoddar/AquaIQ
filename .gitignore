# Environments
venv/
__pycache__/
*.pyc
.env
.env.*
!.env.example
*.db
*.sqlite
*.sqlite3
*.pem
*.key

# Data — too large for git, downloaded fresh by each teammate
data/raw/*
data/processed/*
*.dump
!data/raw/.gitkeep
!data/processed/.gitkeep

# .env.example IS committed (it's a safe template with no real credentials)
# .env is already git-ignored above

# Legacy checkpoints stay external. The compact versioned twelve-month release
# under models/artifacts/ is intentionally tracked with its pointer and card.
models/checkpoints/*.pt
models/checkpoints/*.json
models/checkpoints/bundles/
models/checkpoints/climate_bundles/
models/checkpoints/climate_12m_bundles/
!models/checkpoints/.gitkeep

# Node (dashboard, added Week 4)
node_modules/
dashboard/dist/
dashboard/build/

# OS / editor
.DS_Store
.vscode/
*.log

# MLflow
mlruns/

# Test coverage
.coverage
htmlcov/

# Scratch & temporary investigation scripts
scratch/

# Generated row-level ingestion audit (can exceed GitHub's file limit)
reports/collapsed_rows_log.json
reports/candidates/groundwater_updates/**/*.csv
reports/candidates/groundwater_updates/**/*.png
reports/candidates/**/climate_bundles/
reports/candidates/**/climate_12m_bundles/
reports/candidates/pytest-*/


# Generated station comparison inputs and source renderings
reports/candidates/station_history_20261015/**/*.csv
reports/candidates/station_history_20261015/*.csv
reports/candidates/station_history_20261015/*.png

reports/candidates/rainfall_refresh/

reports/candidates/forecast_replay/*.csv
reports/nationwide_*/cases.csv
reports/nationwide_*/candidate_*.csv
reports/nationwide_*/outputs/

# Official enrichment keeps station rows and generated forecasts local.
reports/data_enrichment/*evaluation/*.csv
reports/data_enrichment/outputs/
reports/data_enrichment/*.png
# Intermediate seal superseded by final_evaluation after portability review.
reports/data_enrichment/release_evaluation/

# Final-release diagnostics retain aggregate metrics, not observation cases.
reports/final_release_20261026/**/cases.csv
reports/final_release_20261026/**/cold_cases.csv
reports/final_release_20261026/outputs/

# Retraining retains compact aggregate reports and model bundles, not target cases.
reports/retraining_20261027/**/*.csv
reports/retraining_20261027/outputs/

# Accuracy studies keep row-level observations and per-fold learners local.
reports/accuracy_experiments_*/**/*.csv
reports/accuracy_experiments_*/**/fold_artifacts/
reports/accuracy_experiments_*/**/*diagnostics*.json

# Reproducible audit row exports; retain compact aggregate reports in Git.
reports/audit-*/**/*.csv
reports/candidates/correlation/

# Paired six-month experiments retain compact summaries/protocols in Git.
reports/candidates/six_month_selection_*/**/*.csv
reports/candidates/six_month_selection_*/experiment*/validation/

# Reproducible independent-audit build output, temporary fixtures and run logs.
# Keep reconstructed cases, metrics, diagnostics, verification and audit scripts.
reports/climate_12m_independent_audit_20261024_01/build/
reports/climate_12m_independent_audit_20261024_01/pytest_tmp/
reports/climate_12m_independent_audit_20261024_01/*.txt
