# AquaIQ — PostgreSQL connection credentials
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real credentials.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aquaiq
POSTGRES_USER=aquaiq_user
POSTGRES_PASSWORD=your_password_here

# Normal 12-month requests read published generations; inference is offline.
AQUAIQ_ENABLE_SYNC_FORECAST_FALLBACK=false
# Optional local validation namespace (must already exist):
# AQUAIQ_FORECAST_SCHEMA=aquaiq_test_nationwide_20261025
# Optional isolated risk-score namespace, created by models.score_all --test-schema:
# AQUAIQ_SCORING_SCHEMA=aquaiq_test_nationwide_20261025
# Empty origins support same-origin reverse proxy deployment.
# AQUAIQ_CORS_ORIGINS=
